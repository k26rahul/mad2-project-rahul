{
  "artificialDelayMilliseconds": 0,
  "keepExistingTerminalsOpen": false,
  "runOnStartup": false,
  "terminals": [
    {
      "splitTerminals": [
        {
          "name": "Flask app",
          "commands": ["cd backend", "./run.sh"],
          "shouldRunCommands": true
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "Frontend",
          "commands": ["cd frontend", "./run.sh"],
          "shouldRunCommands": true
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "Redis",
          "commands": ["cd backend", "redis-server --port 6380"],
          "shouldRunCommands": true
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "Celery",
          "commands": [
            "cd backend",
            "# Wait for Flask app to initialize to prevent race conditions",
            "sleep 2",
            "nodemon --watch app --ext py --exec \"celery -A app.celery_app.celery worker --loglevel=info\""
          ],
          "shouldRunCommands": true
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "Beat",
          "commands": [
            "cd backend",
            "# Wait for Flask app to initialize to prevent race conditions",
            "sleep 2",
            "nodemon --watch app --ext py --exec \"celery -A app.celery_app.celery beat --loglevel=info\""
          ],
          "shouldRunCommands": true
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "MailHog",
          "commands": ["cd backend", "MailHog"],
          "shouldRunCommands": true
        }
      ]
    }
  ]
}
